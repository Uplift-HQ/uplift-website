# HubSpot Form Configuration
# Get these values from your HubSpot account:
# Settings > Marketing > Forms > Select your form > Embed code
VITE_HUBSPOT_PORTAL_ID=your_portal_id_here
VITE_HUBSPOT_FORM_ID=your_form_id_here

# EmailJS Configuration (for email notifications to hello@uplifthq.co.uk)
# 1. Create account at emailjs.com
# 2. Create a service (Gmail recommended)
# 3. Create a template with variables: {{to_email}}, {{from_name}}, {{from_email}}, {{company}}, {{employees}}, {{message}}
# 4. Copy service ID, template ID, and public key below
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# App Store URL
VITE_APP_STORE_URL=https://apps.apple.com/gb/app/uplift-bae629/id6758172662
